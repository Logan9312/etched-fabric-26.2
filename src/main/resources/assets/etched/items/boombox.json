{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {"when":"gui","model":{"type":"minecraft:model","model":"etched:item/boombox_gui"}},
      {"when":"ground","model":{"type":"minecraft:model","model":"etched:item/boombox_gui"}},
      {"when":"fixed","model":{"type":"minecraft:model","model":"etched:item/boombox_gui"}}
    ],
    "fallback": {
      "type":"minecraft:condition",
      "property":"minecraft:has_component",
      "component":"etched:playing_record",
      "on_false":{"type":"minecraft:model","model":"etched:item/boombox_in_hand"},
      "on_true":{
        "type":"minecraft:condition",
        "property":"minecraft:has_component",
        "component":"etched:paused",
        "on_false":{"type":"minecraft:model","model":"etched:item/boombox_in_hand_playing"},
        "on_true":{"type":"minecraft:model","model":"etched:item/boombox_in_hand"}
      }
    }
  }
}
